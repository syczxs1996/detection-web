# 织鉴官网 nginx 配置示例。把 example.com 换成你的域名，证书路径换成实际下载的证书。
# 网站目录结构由 setup-server.sh 建好，deploy.ps1 每次发布到 /var/www/zhijian/releases/，current 指向当前版本。

server {
    listen 80;
    server_name example.com www.example.com;
    # 有证书后，所有 http 访问跳到 https
    return 301 https://example.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com www.example.com;

    ssl_certificate     /etc/nginx/cert/example.com.pem;
    ssl_certificate_key /etc/nginx/cert/example.com.key;

    root  /var/www/zhijian/current;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # 页面不缓存，改了马上生效；图片和脚本缓存 7 天
    location ~* \.html$ { add_header Cache-Control "no-cache"; }
    location /assets/   { expires 7d; }

    location / { try_files $uri $uri/ =404; }
}
